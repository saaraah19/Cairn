# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cairn?retryWrites=true&w=majority
MONGODB_URI=

# Frontend origin allowed to call this API (for CORS)
CLIENT_URL=http://localhost:5173

# Auth (added in Phase 1)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudinary (added in Phase 3 — photo uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
