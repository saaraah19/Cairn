# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cairn?retryWrites=true&w=majority
MONGODB_URI=

# Frontend origin allowed to call this API (for CORS)
CLIENT_URL=http://localhost:5173

# Auth
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Client ID — from Google Cloud Console (APIs & Services > Credentials).
# No Client Secret is needed: the frontend gets an ID token directly via
# Google Identity Services, and the backend verifies it against this Client ID.
# Set the same value in client/.env as VITE_GOOGLE_CLIENT_ID.
# Server boots fine without this — Google sign-in returns 501 until configured.
GOOGLE_CLIENT_ID=

# Cloudinary — from your Dashboard's "Product Environment Credentials" panel
# at cloudinary.com. Server boots fine without these — photo uploads return
# 501 until configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
